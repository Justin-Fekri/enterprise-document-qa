# Optional. When unset, answers are grounded extractively from retrieved
# passages (no external LLM). Set a key to enable generative answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT signing secret for the API. Override in production.
JWT_SECRET=dev-only-change-me

# Backend URL used by the Streamlit UI.
BACKEND_URL=http://127.0.0.1:8765

# Retrieval abstention threshold (0–1). Higher = more conservative.
ABSTAIN_THRESHOLD=0.18
