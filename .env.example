# Copy to .env and adjust. Never commit the real .env.

# --- Answer generation ------------------------------------------------
# Without a key the app falls back to an extractive baseline and still runs.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5
EFFORT=medium

# --- Retrieval --------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_MODE=hybrid
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=6

# Leave unset to use the embedding model's calibrated floor.
# MIN_RELEVANCE_SCORE=0.25

# --- Security ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=480

# --- Service ----------------------------------------------------------
API_URL=http://localhost:8000
MAX_UPLOAD_MB=25
